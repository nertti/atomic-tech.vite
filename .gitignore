# Зависимости (скачиваются заново через npm install)
node_modules/
jspm_packages/
web_modules/

# Результаты сборки (генерируются заново через npm run build)
dist/
build/

# Локальный кэш Vite и инструментов сборки
.vite/
.nuxt/
.next/
.cache/

# Локальные настройки редакторов кода (PhpStorm, VS Code)
.idea/
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Логи ошибок npm
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Конфиденциальные данные и переменные окружения
.env
.env.local
.env.*.local

# Системные файлы ОС
.DS_Store
Thumbs.db
