<section class="home-catalog" id="services" aria-labelledby="home-catalog-title">
    <div class="home-section-watermark" aria-hidden="true">Услуги</div>
    <div class="home-section-heading">
        <h2 id="home-catalog-title">От идеи &mdash;<br>до <span>работающего</span> продукта</h2>
        <div class="home-section-note">
            <img class="home-section-note__corners" src="/img/home-catalog-corners.svg" alt="" aria-hidden="true">
            <p>Не продаём отдельные часы специалистов.<br>Собираем под задачу продуктовую команду<br>и ведём проект от первой гипотезы до запуска</p>
        </div>
    </div>
    <div class="home-catalog__cards" tabindex="0" role="region" aria-label="Направления услуг">
        {{#each serviceGroups}}
        <article class="home-service-card home-service-card--{{variant}}" aria-labelledby="service-{{variant}}-title">
            <div class="home-service-card__intro">
                <h3 id="service-{{variant}}-title">{{title}}</h3>
                <p>{{description}}</p>
            </div>
            <ul class="home-service-card__links">
                {{#each items}}
                <li><a href="#contact"><span>{{this}}</span><span class="home-service-card__arrow" aria-hidden="true">&#8599;</span></a></li>
                {{/each}}
            </ul>
        </article>
        {{/each}}
    </div>
</section>
