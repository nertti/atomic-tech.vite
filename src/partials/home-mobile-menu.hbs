<div class="home-mobile-menu" id="home-mobile-menu" hidden>
    <nav aria-label="Основная навигация">
        <ul class="home-mobile-menu__navigation">
            <li>
                <button class="home-mobile-menu__section-toggle" type="button" data-mobile-services-toggle aria-expanded="false" aria-controls="home-mobile-categories">
                    <span>Услуги</span><span class="home-mobile-menu__indicator" aria-hidden="true"></span>
                </button>
                <div class="home-mobile-menu__categories" id="home-mobile-categories" data-mobile-categories hidden>
                    <ul class="home-mobile-menu__list">
                        {{#each mobileServiceGroups}}
                        <li>
                            <button class="home-mobile-menu__category" id="home-mobile-service-{{variant}}-toggle" type="button" data-mobile-service="{{variant}}" aria-expanded="false" aria-controls="home-mobile-service-{{variant}}">
                                <span class="home-mobile-menu__number">{{number}}</span>
                                <span>{{heading}}</span>
                                <span class="home-mobile-menu__chevron" aria-hidden="true"></span>
                            </button>
                            <section class="home-mobile-menu__services" id="home-mobile-service-{{variant}}" aria-labelledby="home-mobile-service-{{variant}}-toggle" data-mobile-service-panel hidden>
                                <p>{{description}}</p>
                                <h3>Выберите услугу</h3>
                                <ul class="home-mobile-menu__links">
                                    {{#each items}}
                                    <li><a href="{{serviceHref this}}">{{this}}</a></li>
                                    {{/each}}
                                </ul>
                            </section>
                        </li>
                        {{/each}}
                    </ul>
                </div>
            </li>
            <li><a class="home-mobile-menu__section-link" href="#cases">Кейсы</a></li>
            <li><a class="home-mobile-menu__section-link" href="{{#if isServicePage}}index.html{{/if}}#team">Команда</a></li>
            <li><a class="home-mobile-menu__section-link" href="{{#if isServicePage}}index.html{{/if}}#reviews">Отзывы</a></li>
            <li><a class="home-mobile-menu__section-link" href="{{#if isServicePage}}index.html{{/if}}#blog">Блог</a></li>
        </ul>
    </nav>
    <div class="home-mobile-menu__art" aria-hidden="true">
        <img src="/img/home-services.png" width="1792" height="2400" alt="" loading="lazy" decoding="async">
    </div>
</div>
