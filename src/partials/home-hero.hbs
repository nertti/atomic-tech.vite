<section class="home-hero" aria-labelledby="home-title">
    <img class="home-hero__backdrop" src="/img/home-backdrop.svg" alt="" aria-hidden="true">
    <picture class="home-hero__media">
        <source media="(max-width: 600px)" srcset="/img/home-hero-mobile.png">
        <img src="/img/home-hero-v2.png" width="1440" height="730" alt="" fetchpriority="high">
    </picture>
    <div class="home-hero__inner">
        <div class="home-hero__intro">
            <h1 id="home-title">
                <span>Дизайн и разработка</span>
                <span>цифровых продуктов</span>
                <span>под ключ</span>
            </h1>
            <p class="home-hero__subtitle">Проектируем и запускаем сайты, сервисы, приложения, Telegram-продукты, AI- и Web3-решения</p>
            <a class="home-hero__cta" href="#contact">Обсудить проект</a>
        </div>
        <aside class="home-hero__audit" aria-labelledby="home-audit-title">
            <div>
                <h2 id="home-audit-title">Бесплатно<br>проведём аудит готового продукта</h2>
                <p>или предложим варианты реализации вашей идеи</p>
            </div>
            <a href="#contact">Обсудить проект<img src="/img/home-arrow.svg" alt=""></a>
        </aside>
    </div>
</section>

<section class="home-stats" aria-label="Atomic в цифрах">
    <div class="home-stats__items" tabindex="0" role="region" aria-label="Показатели студии">
        <div class="home-stats__item home-stats__item--highlight">
            <div class="home-stats__value">100+</div>
            <div class="home-stats__label">реализованных проектов</div>
        </div>
        <div class="home-stats__item">
            <div class="home-stats__value">200М</div>
            <div class="home-stats__label">общая капитализация проектов</div>
        </div>
        <div class="home-stats__item">
            <div class="home-stats__value">5</div>
            <div class="home-stats__label">лет на рынке</div>
        </div>
        <div class="home-stats__item">
            <div class="home-stats__value">86</div>
            <div class="home-stats__label">довольных клиентов</div>
        </div>
    </div>
</section>
